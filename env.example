# Harbi Ganyan Backend -- Örnek environment dosyası
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# Gerçek .env dosyasını git'e eklemeyin.

HG_APP_ENV=development
HG_DATABASE_URL=postgresql+psycopg2://user:pass@localhost/harbiganyan
HG_JWT_SECRET=<en-az-32-karakter-guclu-secret>
HG_CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# Token V2 -- Stateful refresh sessions (Faz X2F)
# Global feature flag (production'da false kalır, canary ile acilir)
HG_AUTH_TOKEN_V2_ENABLED=false
# Kullanici bazli canary: virgülle ayrılmış pozitif integer user ID'leri.
# Boş bırakılırsa canary kapalı. Global flag false iken yalnızca bu ID'ler V2 alır.
HG_AUTH_TOKEN_V2_ALLOWLIST_USER_IDS=
HG_ACCESS_TOKEN_MINUTES=15
HG_REFRESH_TOKEN_DAYS=30

# SMTP (dogrulama kodu)
HG_SMTP_HOST=
HG_SMTP_PORT=587
HG_SMTP_USER=
HG_SMTP_PASS=
HG_SMTP_FROM=Harbi Ganyan <no-reply@harbiganyan.app>

# Telegram bildirimleri
HG_TELEGRAM_ALERTS_ENABLED=false
HG_TELEGRAM_BOT_TOKEN=
HG_TELEGRAM_CHAT_ID=
